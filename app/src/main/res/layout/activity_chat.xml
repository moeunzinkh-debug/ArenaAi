<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <!-- Top spacer to dismiss activity on click -->
    <View
        android:id="@+id/dismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomDrawerCard" />

    <!-- Bottom drawer container -->
    <LinearLayout
        android:id="@+id/bottomDrawerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Header area for dragging -->
        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- Drag handle indicator -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#D1D1D6" />
        </LinearLayout>

        <!-- WebView container that fills the remaining space -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/chatWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Floating main list menu: New chat / Leaderboard / Search / Settings.
                 Same top-right row as in activity_main.xml: the two native buttons
                 sit left of arena.ai's own "New chat" bubble, equal in size and
                 spacing. The values here are the pre-measurement defaults;
                 MainActivity.alignHeaderIcons() refines them from the live page. -->
            <ImageButton
                android:id="@+id/menuFab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="52dp"
                android:background="@drawable/settings_fab_background"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu_list"
                android:padding="8dp"
                android:alpha="0.85" />

            <!-- Clear-cache shortcut, sitting directly left of the menu button in
                 the same row, sharing its baseline and its gap -->
            <ImageButton
                android:id="@+id/cacheFab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignTop="@id/menuFab"
                android:layout_toStartOf="@id/menuFab"
                android:layout_marginEnd="8dp"
                android:background="@drawable/settings_fab_background"
                android:contentDescription="@string/clear_cache"
                android:src="@drawable/ic_action_clear_cache"
                android:padding="8dp"
                android:alpha="0.85" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
