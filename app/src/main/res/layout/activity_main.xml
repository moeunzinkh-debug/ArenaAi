<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/chatWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Floating main list menu: New chat / Leaderboard / Search / Settings
         (replaces duckAssist's cloned web-button injection, and the old
         settings-only gear) -->
    <ImageButton
        android:id="@+id/menuFab"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_fab_background"
        android:contentDescription="@string/menu"
        android:src="@drawable/ic_menu_list"
        android:padding="10dp"
        android:alpha="0.85" />

    <!-- Clear-cache shortcut, sitting directly left of the menu button -->
    <ImageButton
        android:id="@+id/cacheFab"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignTop="@id/menuFab"
        android:layout_toStartOf="@id/menuFab"
        android:layout_marginEnd="8dp"
        android:background="@drawable/settings_fab_background"
        android:contentDescription="@string/clear_cache"
        android:src="@drawable/ic_action_clear_cache"
        android:padding="10dp"
        android:alpha="0.85" />

</RelativeLayout>
