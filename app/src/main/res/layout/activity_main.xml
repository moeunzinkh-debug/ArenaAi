<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/chatWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- The app's single floating button: clear cache on a tap, app settings on a
         long press. The list menu that used to sit next to it was dropped — its
         New chat / Leaderboard / Search entries only duplicated arena.ai's own
         sidebar, which is still one tap away in the page.

         It is pinned to the top-right corner, immediately left of arena.ai's own
         "New chat" bubble, so both icons form one horizontal row of equally sized,
         equally spaced circles. The margins below are only the first-paint
         defaults: once the page is loaded MainActivity.alignHeaderIcons() measures
         that bubble and rewrites the margins (and the box size) from its real
         geometry, which also keeps the row correct on rotation, on text-size
         changes and on page zoom. -->
    <ImageButton
        android:id="@+id/cacheFab"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/settings_fab_background"
        android:contentDescription="@string/clear_cache"
        android:src="@drawable/ic_action_clear_cache"
        android:padding="8dp"
        android:alpha="0.85" />

</RelativeLayout>
